# Copy to .env.local to change defaults.
# Use the in-browser mock API (default). Set to false once a real backend exists.
VITE_USE_MOCK_API=true
# Simulated network delay of the mock, in milliseconds (default 200).
VITE_MOCK_LATENCY_MS=200
# Largest PDF the mock accepts, in MB (default 5).
VITE_MAX_PDF_MB=5
